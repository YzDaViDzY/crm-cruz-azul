# ------------------------------------------------------------------
# Plantilla de variables. NO escribas aquí credenciales reales.
# Copia este archivo a .env (local) o créalo en el servidor (producción).
# ------------------------------------------------------------------
APP_NAME="Condominio Cruz Azul"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cruzazul
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Datos de demostración (DatabaseSeeder). Mantener en false salvo en desarrollo local.
SEED_DEMO_DATA=false

# --- Valores recomendados SOLO en producción (Hostinger) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://alquilerbol.com
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mysql   (host, base, usuario y contraseña: los de tu panel de Hostinger)

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

